--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ca75b2c51d5b13346bb27b61dae5a1c0, type: 3}
  m_Name: GameData
  m_EditorClassIdentifier: 
  questions:
  - id: Q0
    prompt: "Ah\u2026 te voila enfin. Meme ta respiration sonne comme une excuse. 
      Laisse-moi reflechir\u2026 comment te briser en douceur pour commencer ?"
    reponses:
    - text: Faire grincer le parquet, derriere toi?
      impact: -1
      nextQuestion: -1
    - text: Eteindre la lumiere alors que tu viens de l'allumer?
      impact: 0
      nextQuestion: 2
    - text: faire tomber un cadre a cote de ta bete tete?
      impact: 1
      nextQuestion: 2
    background: 0
  - id: Q1
    prompt: "Interessant\u2026 Tu as suivi le bruit sans reflechir. Les humains font
      souvent ca quand ils sont nerveux. Ici, tout est fragile\u2026 et toi aussi.
      Qu\u2019est-ce que je teste sur toi ?"
    reponses:
    - text: Faire vibrer la vaisselle?
      impact: -1
      nextQuestion: -2
    - text: Claquer le tiroir des couteaux?
      impact: 1
      nextQuestion: 2
    - text: Faire voler un couteau vers toi?
      impact: 2
      nextQuestion: 2
    background: 2
  - id: Q2
    prompt: "Ah\u2026 la chambre. Tu t\u2019es dit que ce serait plus calme. Que
      tu serais en securite.  Je vais prendre mon temps. Jouer avec toi.  Comment
      t\u2019ab\xEEmer lentement ?"
    reponses:
    - text: Affaisser le matelas a cote de toi?
      impact: -1
      nextQuestion: -1
    - text: "Tirer ta couverture d\u2019un coup sec?"
      impact: 1
      nextQuestion: -1
    - text: Te trainer hors du lit?
      impact: 2
      nextQuestion: -1
    background: 1
  - id: Q3
    prompt: "Peu importe ou tu vas. Je te trouve. Toujours.  Tu n\u2019es pas en
      fuite. Tu es deja a moi.  Comment te demolir ?"
    reponses:
    - text: Faire passer une ombre devant lui?
      impact: -1
      nextQuestion: -1
    - text: Remplacer ta voix par la mienne?
      impact: 1
      nextQuestion: -1
    - text: Te tirer les cheveux et te mettre une giffle?
      impact: 2
      nextQuestion: -1
    background: 2
  badEndingMax: -1
  neutralEndingMax: 3
  goodEndingMin: 4
