  m_Script: {fileID: 11500000, guid: ca75b2c51d5b13346bb27b61dae5a1c0, type: 3}
  m_Name: GameData
  m_EditorClassIdentifier: 
  questions:
  - id: Q0
    prompt: "Ah\u2026 te voil\xE0 enfin. M\xEAme ta respiration sonne comme une excuse.
      Laisse-moi r\xE9fl\xE9chir\u2026 comment te briser en douceur pour commencer
      ?"
    reponses:
    - text: Faire grincer le parquet.
      impact: -1
      nextQuestion: -1
    - text: "\xC9teindre tout d\u2019un coup."
      impact: 0
      nextQuestion: 2
    - text: Claquer toutes les portes.
      impact: 2
      nextQuestion: 2
    background: 0
  - id: Q1
    prompt: "La cuisine\u2026 l\u2019endroit parfait pour commencer les d\xE9g\xE2ts.
      Tout ici coupe, pique, ou cong\xE8le. Et toi, tu trembles d\xE9j\xE0."
    reponses:
    - text: Faire vibrer les verres.
      impact: -1
      nextQuestion: -2
    - text: Claquer le tiroir aux couteaux.
      impact: 1
      nextQuestion: 2
    - text: Faire voler un couteau.
      impact: 2
      nextQuestion: 2
    background: 2
  - id: Q2
    prompt: "La chambre\u2026 enfin un lieu intime. Tu devrais te sentir en s\xE9curit\xE9
      ici. C\u2019est fou comme certains croient encore \xE0 \xE7a."
    reponses:
    - text: "Faire s\u2019affaisser le matelas."
      impact: -1
      nextQuestion: -1
    - text: "Tirer la couverture d\u2019un coup sec."
      impact: 1
      nextQuestion: -1
    - text: "Te tra\xEEner hors du lit."
      impact: 2
      nextQuestion: -1
    background: 1
  - id: Q3
    prompt: "Et te voil\xE0  dans ma cuisine\u2026 dans mon ventre. Alors\u2026 qu\u2019est-ce
      que je prends en premier ?"
    reponses:
    - text: "\xC9touffer un souvenir."
      impact: -1
      nextQuestion: -1
    - text: Te voler ta voix.
      impact: 1
      nextQuestion: -1
    - text: "T\u2019\xE9vider de l\u2019int\xE9rieur"
      impact: 2
      nextQuestion: -1
    background: 2
  badEndingMax: -1
  neutralEndingMax: 3
  goodEndingMin: 4
